<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive security preferences and internal database from automatic cloud backup -->
        <exclude domain="sharedpref" path="smsgram_prefs.xml" />
        <exclude domain="database" path="smsgram_internal.db" />
        <exclude domain="database" path="smsgram_internal.db-wal" />
        <exclude domain="database" path="smsgram_internal.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="smsgram_prefs.xml" />
        <exclude domain="database" path="smsgram_internal.db" />
        <exclude domain="database" path="smsgram_internal.db-wal" />
        <exclude domain="database" path="smsgram_internal.db-shm" />
    </device-transfer>
</data-extraction-rules>
