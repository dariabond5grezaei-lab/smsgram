    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded Message Bubble Outline with Neon Violet-to-Teal Gradient -->
    <path
        android:pathData="M32,28 L72,28 C78.6,28 84,33.4 84,40 L84,66 C84,72.6 78.6,78 72,78 L46,78 L34,86 L36,78 C29.4,78 24,72.6 24,66 L24,40 C24,33.4 29.4,28 32,28 Z"
