    <path
        android:pathData="M68,37 C72,34 76,34 80,37"
        android:strokeColor="#64FFDA"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Sleek Geometric Letter "S" in Center -->
    <path
        android:pathData="M63,42 L48,42 C44.5,42 41.5,44.8 41.5,48.2 C41.5,51.8 44.5,54.5 48.5,54.5 L57.5,54.5 C61.5,54.5 64.5,57.2 64.5,60.8 C64.5,64.2 61.5,67 58,67 L42,67"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Cellular Dots indicator at bottom right inside bubble -->
    <path
        android:pathData="M66,61 A1.8,1.8 0 1,0 69.6,61 A1.8,1.8 0 1,0 66,61"
        android:fillColor="#00E5FF" />
    <path
