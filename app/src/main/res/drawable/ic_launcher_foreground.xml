        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="28"
                android:endX="84"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#7C4DFF" />
                <item android:offset="0.5" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#64FFDA" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="24"
                android:startY="28"
                android:endX="84"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A7C4DFF" />
                <item android:offset="1.0" android:color="#1A00E5FF" />
            </gradient>
        </aapt:attr>
